<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="datos">
    <class name="Pedido" table="pedido">
        <id name="id" column="id_Pedido" type="java.lang.Long">
            <generator class="identity"/>
        </id>
        <property name="fecha" column="fecha" type="java.time.LocalDate" not-null="true"/>
        

        <many-to-one name="festival" column="id_Festival" class="Festival" not-null="true" outer-join="true"/>
        <many-to-one name="unidadVenta" column="id_UnidadVenta" class="UnidadVenta" not-null="true" outer-join="true"/>


        <set name="items" cascade="all-delete-orphan" outer-join="true">
            <key column="id_Pedido" not-null="true" />
            <one-to-many class="ItemPedido"/>
        </set>
    </class>
</hibernate-mapping>