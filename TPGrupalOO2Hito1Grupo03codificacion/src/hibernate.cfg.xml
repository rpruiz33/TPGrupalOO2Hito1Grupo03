<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>
		<property name="connection.driver_class">com.mysql.jdbc.Driver</property>
		<property name="connection.url">
			jdbc:mysql://localhost/epicentro_gourmet?serverTimezone=UTC</property> <!-- Se cambio el nombre por la base que tengo, deberíamos ponernos de acuerdo en el nombre   -->
		<property name="connection.username">root</property>
		<property name="connection.password">root</property><!-- tratar de unificar la clave para todos   -->
		<property name="connection.pool_size">1</property>
		<property name="dialect">org.hibernate.dialect.MySQLDialect</property>
		<property name="show_sql">false</property><!-- en true muestra hql en consola-->
		<!--Mapeo Entidades   -->
		<mapping resource="mapeos/Festival.hbm.xml" />
		<mapping resource="mapeos/Staff.hbm.xml" />
        <mapping resource="mapeos/UnidadDeVenta.hbm.xml" />
        <mapping resource="mapeos/Pedido.hbm.xml" />
        <mapping resource="mapeos/ItemPedido.hbm.xml" />
        <mapping resource="mapeos/Plato.hbm.xml"/>
	</session-factory>
</hibernate-configuration>