<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="datos">
    <class name="Festival" table="festival">
        <id name="id" column="id_Festival" type="java.lang.Long">
            <generator class="identity"/>
        </id>
        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="temporada" column="temporada" type="string" not-null="true"/>
        <property name="fechaInicio" column="fechaInicio" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaFin" column="fechaFin" type="java.time.LocalDate" not-null="true"/>

        <set name="unidadesHabilitadas" table="festival_unidadventa">
   			 <key column="id_Festival"/>
    			<many-to-many column="id_UnidadVenta" class="UnidadVenta"/>
			</set>
		<set name="staffGeneral" table="festival_staff">
    			<key column="id_Festival"/>
    			<many-to-many column="id_Staff"  class="Staff"/>
			</set>
          </class>
</hibernate-mapping>