        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam classAttributeIconSize 0\n\nclass Festival {\n    - id: Long\n    - nombre: String\n    - temporada: String\n    - fechaInicio: LocalDate\n    - fechaFin: LocalDate\n    - costoPorSuperficie: Double\n    - costoPorMontaje: Double\n    - plusUsoElectricidad: Double\n    - sueldoBase: Double\n}\n\nabstract class UnidadVenta {\n    - id: Long\n    - nombreComercial: String\n    - superficie: Double\n    - codigoUnico: String\n    + validarCodigoUnico(): Boolean\n}\n\nclass FoodTruck {\n    - patente: String\n    - requiereElectricidad: Boolean\n}\n\nclass PuestoDesarmable {\n    - cantidadCarpas: Integer\n    - tiempoMontajeMinutos: Integer\n}\n\nabstract class Staff {\n    - id: Long\n    - nombre: String\n    - apellido: String\n    - dni: String\n    - fechaNacimiento: LocalDate\n    - fechaIngreso: LocalDate\n    - sueldoBase: Double\n    + esMayorDeEdad(): Boolean\n    + calcularAntiguedad(): Integer\n}\n\nclass Cocinero {\n    - especialidad: String\n    - plusFijoCategoria: Double\n}\n\nclass Cajero {\n    - turno: String\n}\n\nclass Plato {\n    - id: Long\n    - nombre: String\n    - precioVenta: Double\n    - costoProduccion: Double\n}\n\nclass Pedido {\n    - id: Long\n    - fechaTransaccion: LocalDateTime\n}\n\nclass DetallePedido {\n    - id: Long\n    - cantidad: Integer\n}\n\nUnidadVenta &lt;|-- FoodTruck\nUnidadVenta &lt;|-- PuestoDesarmable\nStaff &lt;|-- Cocinero\nStaff &lt;|-- Cajero\n\nFestival -- UnidadVenta\nUnidadVenta -- Staff\nUnidadVenta -- Plato\n\nPedido -- Festival\nPedido -- UnidadVenta\n\nPedido *-- DetallePedido\nDetallePedido -- Plato\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BsSUQrAKGfDnKd3l1tLX-109">
